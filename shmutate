#!/usr/bin/env bash
set -euo pipefail

RUN_CMD=${SHMUTATE_RUN:-bats test}

usage() {
  cat <<EOF
shmutate - mutation testing for shell scripts and bats-core

  shmutate [options] <file>...

Breaks your code on purpose, one operator at a time, reruns the suite, and
lists the changes your tests failed to catch.

  --run CMD        command to run per mutant (default "bats test", \$SHMUTATE_RUN)
  -h, --help       this help
EOF
}

# find mutable operators in one file, skipping anything inside quotes or
# comments. prints: file<TAB>line<TAB>col<TAB>len<TAB>from<TAB>to<TAB>src
scan_file() {
  awk -v fname="$1" '
    BEGIN {
      FLIP["-eq"]="-ne"; FLIP["-ne"]="-eq"
      FLIP["-lt"]="-ge"; FLIP["-ge"]="-lt"
      FLIP["-gt"]="-le"; FLIP["-le"]="-gt"
      FLIP["-z"]="-n";   FLIP["-n"]="-z"
      FLIP["=="]="!=";   FLIP["!="]="=="
      FLIP["&&"]="||";   FLIP["||"]="&&"
      FLIP["true"]="false"; FLIP["false"]="true"
    }
    # blank out quoted spans and trailing comments, keeping length so column
    # offsets still line up with the original line
    function mask(s,   i,ch,q,out) {
      out=""; q=""
      for (i = 1; i <= length(s); i++) {
        ch = substr(s, i, 1)
        if (q == "") {
          if (ch == "#") { while (i <= length(s)) { out = out "."; i++ }; break }
          else if (ch == "\047" || ch == "\042") { q = ch; out = out "." }
          else out = out ch
        } else {
          if (ch == q) q = ""
          out = out "."
        }
      }
      return out
    }
    {
      m = mask($0); L = length(m); i = 1
      src = $0; sub(/^[ \t]+/, "", src)
      while (i <= L) {
        if (substr(m, i, 1) ~ /[ \t]/) { i++; continue }
        st = i
        while (i <= L && substr(m, i, 1) !~ /[ \t]/) i++
        tok = substr(m, st, i - st)
        if (tok in FLIP)
          printf "%s\t%d\t%d\t%d\t%s\t%s\t%s\n", fname, NR, st, i - st, tok, FLIP[tok], src
      }
    }
  ' "$1"
}

# rewrite line ln of file, replacing the operator at column st with to
apply_at() {
  awk -v ln="$2" -v st="$3" -v len="$4" -v to="$5" '
    NR==ln { $0 = substr($0, 1, st-1) to substr($0, st+len) }
    { print }
  ' "$1"
}

files=()
while (($#)); do
  case $1 in
    --run) RUN_CMD=$2; shift 2 ;;
    --run=*) RUN_CMD=${1#*=}; shift ;;
    -h | --help) usage; exit 0 ;;
    --) shift; files+=("$@"); break ;;
    -*) echo "shmutate: unknown option: $1" >&2; exit 2 ;;
    *) files+=("$1"); shift ;;
  esac
done
[[ ${#files[@]} -gt 0 ]] || { usage >&2; exit 2; }

run_suite() { eval "$RUN_CMD"; }

for f in "${files[@]}"; do
  [[ -f $f ]] || { echo "shmutate: no such file: $f" >&2; exit 1; }
done

echo "shmutate: checking baseline suite..." >&2
if ! run_suite >/dev/null 2>&1; then
  echo "shmutate: baseline suite is failing; fix your tests before mutating" >&2
  exit 1
fi

muts=()
for f in "${files[@]}"; do
  while IFS= read -r rec; do muts+=("$rec"); done < <(scan_file "$f")
done

total=${#muts[@]}
if ((total == 0)); then
  echo "shmutate: no mutable operators found in: ${files[*]}" >&2
  exit 0
fi

# stash originals up front so a Ctrl+C can't leave mutated code on disk
bak=$(mktemp -d)
declare -A saved=()
k=0
for f in "${files[@]}"; do
  cp "$f" "$bak/$k"
  saved[$f]=$bak/$k
  k=$((k + 1))
done
restore_all() {
  for g in "${!saved[@]}"; do cp "${saved[$g]}" "$g" 2>/dev/null || true; done
}
trap 'restore_all; rm -rf "$bak"' EXIT INT TERM

printf 'shmutate: %d mutants across %s\n\n' "$total" "${files[*]}" >&2

killed=0 survived=0
survivors=()
tmp=$(mktemp)
for rec in "${muts[@]}"; do
  IFS=$'\t' read -r f ln st len from to src <<<"$rec"
  apply_at "$f" "$ln" "$st" "$len" "$to" >"$tmp"
  cp "$tmp" "$f"
  if run_suite >/dev/null 2>&1; then
    survived=$((survived + 1))
    survivors+=("$(printf 'SURVIVED  %s:%s  [ %s -> %s ]  %s' "$f" "$ln" "$from" "$to" "$src")")
  else
    killed=$((killed + 1))
  fi
  cp "${saved[$f]}" "$f"
done
rm -f "$tmp"

echo
for s in "${survivors[@]}"; do echo "$s"; done

score=$((killed * 100 / total))
printf '\nScore: %d/%d killed (%d%%)' "$killed" "$total" "$score"
((survived)) && printf '  - %d survived' "$survived"
echo

((survived == 0))
