#!/usr/bin/env bash
set -euo pipefail

RUN_CMD=${MUTANTS_RUN:-bats test}
THRESHOLD=100
VERBOSE=0

# operator -> its flip, one mutant generated per direction
OPS=(
  -eq:-ne -ne:-eq -lt:-ge -ge:-lt -gt:-le -le:-gt
  -z:-n -n:-z
  "==:!=" "!=:=="
  "&&:||" "||:&&"
  true:false false:true
)

usage() {
  cat <<EOF
mutants - mutation testing for shell scripts and bats-core

  mutants [options] <file>...

Breaks your code on purpose, one operator at a time, reruns the suite, and
lists the changes your tests failed to catch.

  --run CMD        command to run per mutant (default "bats test", \$MUTANTS_RUN)
  --threshold N    kill score % needed to exit 0 (default 100)
  -v, --verbose    also print killed mutants
  -h, --help       this help
EOF
}

# how many times sub occurs in s (non-overlapping)
count_occ() {
  local s=$1 sub=$2 n=0
  while [[ $s == *"$sub"* ]]; do
    s=${s#*"$sub"}
    n=$((n + 1))
  done
  echo "$n"
}

apply_mutation() {
  local f=$1 ln=$2 occ=$3 from=$4 to=$5
  # flip only the occ-th " from " on line ln; awk index() is 1-based
  awk -v ln="$ln" -v occ="$occ" -v from=" $from " -v to=" $to " '
    NR==ln {
      s=$0; out=""; c=0; fl=length(from)
      while ((p=index(s, from)) > 0) {
        c++
        out = out substr(s, 1, p-1) (c==occ ? to : from)
        s = substr(s, p+fl)
      }
      print out s; next
    }
    { print }
  ' "$f"
}

files=()
while (($#)); do
  case $1 in
    --run) RUN_CMD=$2; shift 2 ;;
    --run=*) RUN_CMD=${1#*=}; shift ;;
    --threshold) THRESHOLD=$2; shift 2 ;;
    --threshold=*) THRESHOLD=${1#*=}; shift ;;
    -v | --verbose) VERBOSE=1; shift ;;
    -h | --help) usage; exit 0 ;;
    --) shift; files+=("$@"); break ;;
    -*) echo "mutants: unknown option: $1" >&2; exit 2 ;;
    *) files+=("$1"); shift ;;
  esac
done
[[ ${#files[@]} -gt 0 ]] || { usage >&2; exit 2; }

run_suite() { eval "$RUN_CMD"; }

for f in "${files[@]}"; do
  [[ -f $f ]] || { echo "mutants: no such file: $f" >&2; exit 1; }
done

echo "mutants: checking baseline suite..." >&2
if ! run_suite >/dev/null 2>&1; then
  echo "mutants: baseline suite is failing; fix your tests before mutating" >&2
  exit 1
fi

# one descriptor per (file, line, occurrence, operator)
muts=()
for f in "${files[@]}"; do
  n=0
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    trimmed=${line#"${line%%[![:space:]]*}"}
    case $trimmed in \#*) continue ;; esac
    for pair in "${OPS[@]}"; do
      from=${pair%%:*}; to=${pair#*:}
      c=$(count_occ "$line" " $from ")
      for ((i = 1; i <= c; i++)); do
        muts+=("$f"$'\t'"$n"$'\t'"$i"$'\t'"$from"$'\t'"$to"$'\t'"$trimmed")
      done
    done
  done <"$f"
done

total=${#muts[@]}
if ((total == 0)); then
  echo "mutants: no mutable operators found in: ${files[*]}" >&2
  exit 0
fi

# stash originals up front so a Ctrl+C can't leave mutated code on disk
bak=$(mktemp -d)
declare -A saved=()
k=0
for f in "${files[@]}"; do
  cp "$f" "$bak/$k"
  saved[$f]=$bak/$k
  k=$((k + 1))
done
restore_all() {
  for g in "${!saved[@]}"; do cp "${saved[$g]}" "$g" 2>/dev/null || true; done
}
trap 'restore_all; rm -rf "$bak"' EXIT INT TERM

printf 'mutants: %d mutants across %s\n\n' "$total" "${files[*]}" >&2

killed=0 survived=0
survivors=()
tmp=$(mktemp)
for d in "${muts[@]}"; do
  IFS=$'\t' read -r f ln occ from to src <<<"$d"
  apply_mutation "$f" "$ln" "$occ" "$from" "$to" >"$tmp"
  cp "$tmp" "$f"
  if run_suite >/dev/null 2>&1; then
    survived=$((survived + 1))
    survivors+=("$(printf 'SURVIVED  %s:%s  [ %s -> %s ]  %s' "$f" "$ln" "$from" "$to" "$src")")
  else
    killed=$((killed + 1))
    ((VERBOSE)) && echo "KILLED    $f:$ln  [ $from -> $to ]"
  fi
  cp "${saved[$f]}" "$f"
done
rm -f "$tmp"

echo
for s in "${survivors[@]}"; do echo "$s"; done

score=$((killed * 100 / total))
printf '\nScore: %d/%d killed (%d%%)' "$killed" "$total" "$score"
((survived)) && printf '  - %d survived' "$survived"
echo

((score >= THRESHOLD))
